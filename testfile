provider "aws" {
  region = "ap-south-2"
}

# ============================================================
# 1. DATA - Availability Zones
# ============================================================

data "aws_availability_zones" "available" {
  state = "available"
}


# ============================================================
# 2. VPC
# ============================================================

resource "aws_vpc" "terrefvpc" {
  cidr_block           = "10.0.0.0/16"
  enable_dns_support   = true
  enable_dns_hostnames = true

  tags = {
    Name = "my-vpc"
  }
}


# ============================================================
# 3. PUBLIC SUBNET - AZ 1
# ============================================================

resource "aws_subnet" "public_a" {
  vpc_id                  = aws_vpc.terrefvpc.id
  cidr_block              = "10.0.1.0/24"
  availability_zone       = data.aws_availability_zones.available.names[0]
  map_public_ip_on_launch = true

  tags = {
    Name = "public-subnet-a"
  }
}


# ============================================================
# 4. PUBLIC SUBNET - AZ 2
# ============================================================

resource "aws_subnet" "public_b" {
  vpc_id                  = aws_vpc.terrefvpc.id
  cidr_block              = "10.0.2.0/24"
  availability_zone       = data.aws_availability_zones.available.names[1]
  map_public_ip_on_launch = true

  tags = {
    Name = "public-subnet-b"
  }
}


# ============================================================
# 5. PRIVATE SUBNET - AZ 1
# ============================================================

resource "aws_subnet" "private_a" {
  vpc_id            = aws_vpc.terrefvpc.id
  cidr_block        = "10.0.3.0/24"
  availability_zone = data.aws_availability_zones.available.names[0]

  tags = {
    Name = "private-subnet-a"
  }
}


# ============================================================
# 6. PRIVATE SUBNET - AZ 2
# ============================================================

resource "aws_subnet" "private_b" {
  vpc_id            = aws_vpc.terrefvpc.id
  cidr_block        = "10.0.4.0/24"
  availability_zone = data.aws_availability_zones.available.names[1]

  tags = {
    Name = "private-subnet-b"
  }
}


# ============================================================
# 7. INTERNET GATEWAY
# ============================================================

resource "aws_internet_gateway" "igw" {
  vpc_id = aws_vpc.terrefvpc.id

  tags = {
    Name = "my-internet-gateway"
  }
}


# ============================================================
# 8. PUBLIC ROUTE TABLE
# ============================================================

resource "aws_route_table" "public" {
  vpc_id = aws_vpc.terrefvpc.id

  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.igw.id
  }

  tags = {
    Name = "public-route-table"
  }
}


# ============================================================
# 9. PUBLIC ROUTE TABLE ASSOCIATION - AZ 1
# ============================================================

resource "aws_route_table_association" "public_a" {
  subnet_id      = aws_subnet.public_a.id
  route_table_id = aws_route_table.public.id
}


# ============================================================
# 10. PUBLIC ROUTE TABLE ASSOCIATION - AZ 2
# ============================================================

resource "aws_route_table_association" "public_b" {
  subnet_id      = aws_subnet.public_b.id
  route_table_id = aws_route_table.public.id
}


# ============================================================
# 11. ELASTIC IP FOR NAT GATEWAY
# ============================================================

resource "aws_eip" "nat" {
  domain = "vpc"

  tags = {
    Name = "nat-eip"
  }
}


# ============================================================
# 12. NAT GATEWAY
# ============================================================

resource "aws_nat_gateway" "nat" {
  allocation_id = aws_eip.nat.id
  subnet_id     = aws_subnet.public_a.id

  depends_on = [
    aws_internet_gateway.igw
  ]

  tags = {
    Name = "my-nat-gateway"
  }
}


# ============================================================
# 13. PRIVATE ROUTE TABLE
# ============================================================

resource "aws_route_table" "private" {
  vpc_id = aws_vpc.terrefvpc.id

  route {
    cidr_block     = "0.0.0.0/0"
    nat_gateway_id = aws_nat_gateway.nat.id
  }

  tags = {
    Name = "private-route-table"
  }
}


# ============================================================
# 14. PRIVATE ROUTE TABLE ASSOCIATION - AZ 1
# ============================================================

resource "aws_route_table_association" "private_a" {
  subnet_id      = aws_subnet.private_a.id
  route_table_id = aws_route_table.private.id
}


# ============================================================
# 15. PRIVATE ROUTE TABLE ASSOCIATION - AZ 2
# ============================================================

resource "aws_route_table_association" "private_b" {
  subnet_id      = aws_subnet.private_b.id
  route_table_id = aws_route_table.private.id
}


# ============================================================
# 16. ALB SECURITY GROUP
# ============================================================

resource "aws_security_group" "alb_sg" {
  name        = "alb-security-group"
  description = "Security group for Application Load Balancer"
  vpc_id      = aws_vpc.terrefvpc.id

  ingress {
    description = "Allow HTTP from Internet"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    description = "Allow all outbound traffic"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "alb-security-group"
  }
}


# ============================================================
# 17. EC2 SECURITY GROUP
# ============================================================

resource "aws_security_group" "ec2_sg" {
  name        = "ec2-security-group"
  description = "Security group for EC2 instances"
  vpc_id      = aws_vpc.terrefvpc.id

  # Allow application traffic only from ALB
  ingress {
    description     = "Allow HTTP from ALB"
    from_port       = 80
    to_port         = 80
    protocol        = "tcp"
    security_groups = [aws_security_group.alb_sg.id]
  }

  egress {
    description = "Allow all outbound traffic"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "ec2-security-group"
  }
}


# ============================================================
# 18. TARGET GROUP
# ============================================================

resource "aws_lb_target_group" "terreftg" {
  name     = "my-application-target-group"
  port     = 80
  protocol = "HTTP"
  vpc_id   = aws_vpc.terrefvpc.id

  health_check {
    enabled             = true
    path                = "/"
    port                = "80"
    protocol            = "HTTP"
    healthy_threshold   = 2
    unhealthy_threshold = 2
    timeout             = 5
    interval            = 30
  }

  tags = {
    Name = "my-target-group"
  }
}


# ============================================================
# 19. APPLICATION LOAD BALANCER
# ============================================================

resource "aws_lb" "terrefalb" {
  name               = "my-app-alb"
  internal           = false
  load_balancer_type = "application"

  security_groups = [
    aws_security_group.alb_sg.id
  ]

  subnets = [
    aws_subnet.public_a.id,
    aws_subnet.public_b.id
  ]

  tags = {
    Name = "my-application-load-balancer"
  }
}


# ============================================================
# 20. ALB LISTENER
# ============================================================

resource "aws_lb_listener" "terreflistener" {
  load_balancer_arn = aws_lb.terrefalb.arn

  port     = 80
  protocol = "HTTP"

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.terreftg.arn
  }
}


# ============================================================
# 21. LAUNCH TEMPLATE
# ============================================================

resource "aws_launch_template" "terreflaunchtemplate" {
  name = "my-app-launch-template"

  # Your AMI
  image_id = "ami-0199ac7c9fbf9ed83"

  instance_type = "t2.micro"

  key_name = "mynewkey"

  # EC2 Security Group
  vpc_security_group_ids = [
    aws_security_group.ec2_sg.id
  ]

  # User Data
  user_data = base64encode(<<-EOF
    #!/bin/bash

    yum install -y httpd

    systemctl start httpd
    systemctl enable httpd

    echo "Welcome to Myapp - $(hostname)" > /var/www/html/index.html
  EOF
  )

  # EC2 instance tags
  tag_specifications {
    resource_type = "instance"

    tags = {
      Name = "myapp-server"
    }
  }

  lifecycle {
    create_before_destroy = true
  }
}


# ============================================================
# 22. AUTO SCALING GROUP
# ============================================================

resource "aws_autoscaling_group" "terefautoscalinggroup" {
  name = "my-app-autoscaling-group"

  min_size         = 1
  desired_capacity = 1
  max_size         = 3

  # EC2 instances will be created in private subnets
  vpc_zone_identifier = [
    aws_subnet.private_a.id,
    aws_subnet.private_b.id
  ]

  # Use Launch Template
  launch_template {
    id      = aws_launch_template.terreflaunchtemplate.id
    version = "$Latest"
  }

  # Automatically register ASG instances
  # with the Target Group
  target_group_arns = [
    aws_lb_target_group.terreftg.arn
  ]

  # ASG checks instance health using ALB
  health_check_type         = "ELB"
  health_check_grace_period = 120

  tag {
    key                 = "Name"
    value               = "ASG-App-Server"
    propagate_at_launch = true
  }

  depends_on = [
    aws_lb_listener.terreflistener
  ]
}


# ============================================================
# 23. AUTO SCALING POLICY
# ============================================================

resource "aws_autoscaling_policy" "terref_target_tracking" {
  name                   = "cpu-target-tracking-policy"
  autoscaling_group_name = aws_autoscaling_group.terefautoscalinggroup.name

  policy_type = "TargetTrackingScaling"

  target_tracking_configuration {
    predefined_metric_specification {
      predefined_metric_type = "ASGAverageCPUUtilization"
    }

    target_value = 50.0
  }
}


# ============================================================
# 24. OUTPUT - ALB DNS NAME
# ============================================================

output "alb_dns_name" {
  description = "Application Load Balancer DNS name"
  value       = aws_lb.terrefalb.dns_name
}


# ============================================================
# 25. OUTPUT - TARGET GROUP ARN
# ============================================================

output "target_group_arn" {
  description = "Target Group ARN"
  value       = aws_lb_target_group.terreftg.arn
}


# ============================================================
# 26. OUTPUT - AUTO SCALING GROUP NAME
# ============================================================

output "autoscaling_group_name" {
  description = "Auto Scaling Group name"
  value       = aws_autoscaling_group.terefautoscalinggroup.name
}